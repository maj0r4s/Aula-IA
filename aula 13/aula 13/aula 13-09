<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Animes FMU</title>
<style>
  body { background: #52057B; font-family: 'Times New Roman', serif; color: #fff; margin: 0; padding: 15px; display: flex; flex-direction: column; gap: 15px; min-height: 95vh; }
  header, main, footer, section { border: 2px solid rgba(255,255,255,0.4); padding: 15px; background: rgba(0,0,0,0.1); }
  h1 { font-size: 1.8rem; margin: 0; }
  nav, menu { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; margin-top: 10px; }
  a, button { background: #fff; color: #52057B; padding: 8px 14px; text-decoration: none; font-family: 'Times New Roman', serif; font-weight: bold; border: none; cursor: pointer; }
  main { display: grid; grid-template-columns: 250px 1fr; gap: 15px; }
  @media(max-width:768px){ main { grid-template-columns: 1fr; } }
  aside { border: 1px dashed #fff; padding: 15px; text-align: center; font-weight: bold; display: flex; align-items: center; justify-content: center; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  @media(max-width:900px){ .grid { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:500px){ .grid { grid-template-columns: 1fr; } }
  .card { background: #fff; color: #52057B; aspect-ratio: 3/4; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: bold; font-size: 1.1rem; }
  footer { font-size: 0.95rem; letter-spacing: 1px; }
</style>
</head>
<body>

  <header>
    <h1>ANIMES FMU</h1>
    <nav>
      <div>
        <a href="#">Lançamento</a>
        <a href="#">Top 10</a>
        <a href="#">Filtro</a>
        <a href="#">Popular</a>
      </div>
      <div>
        <a href="#">Instagram</a>
        <a href="#">Twitter</a>
        <a href="#">Discord</a>
        <a href="#">Facebook</a>
      </div>
    </nav>
  </header>

  <main>
    <aside>
      PRECISA-SE DE TRADUTOR<br>(fluente em japonês)
    </aside>
    <section>
      <div class="grid">
        <article class="card">MO MO MO MO</article>
        <article class="card">MO MO MO MO</article>
        <article class="card">MO MO MO MO</article>
        <article class="card">MO MO MO MO</article>
      </div>
    </section>
  </main>

  <footer>
    CONTATO: ANIMESFMU@GMAIL.COM
  </footer>

</body>
</html>
